{
  "name": "fireflow-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "for f in $(find test/unit -name '*.test.ts' | sort); do echo \"--- $f ---\"; npx tsx \"$f\" || exit 1; done",
    "ocr:benchmark": "tsx lib/ocr-benchmark/runBenchmark.ts",
    "ocr:compare": "tsx lib/ocr-compare/runCompare.ts"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@google-cloud/vision": "^4.3.2",
    "@google-cloud/documentai": "^8.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0",
    "tsx": "^4.19.0"
  }
}
