# [2026-07-20新設]
# ローカルで `npm run dev` を使ってテストする場合に使うファイルです。
# このファイルをコピーして `.env.local` という名前で保存し、実際の値を入れてください
# (.env.local は .gitignore 済みで、gitにコミットされません)。
#
# 本番(Vercelにデプロイしたあと)は、このファイルではなく
# Vercelダッシュボード → プロジェクト → Settings → Environment Variables
# で同じ名前の変数を設定してください(Production / Preview / Development それぞれに
# 設定が必要です)。
#
# 【重要・最重要】このファイルに実際の値を書き込んだ .env.local を、絶対にgitに
# コミットしたり、Slack等で共有したりしないでください。もし誤って公開してしまった
# 場合は、該当するキーを速やかに無効化・再発行してください。

# ---- Anthropic (Claude) ----
# 点検希望時間連絡票のAIスキャン(OCR)機能が使用します。
# 取得先: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Supabase ----
# 通常は public/supabase-integration.js 冒頭の SUPABASE_URL と同じ値でよいため
# 省略可能です(未設定時は同じ既定値が使われます)。別プロジェクトのURLに変えたい
# 場合のみ設定してください。
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# 【最重要】Supabaseダッシュボード → Project Settings → API → 「service_role」キー(secret)。
# これはRLS(行レベルセキュリティ)を無視して読み書きできる、非常に強い権限を持つ鍵です。
# 絶対にブラウザ側のコード(public/配下)や公開リポジトリに含めないでください。
# Vercelの環境変数にのみ設定し、このプロジェクト内では lib/config/env.ts 経由でしか
# 参照してはいけません。
SUPABASE_SERVICE_ROLE_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- OpenAI (将来用) ----
# [2026-08-05修正] 以前このコメントは「OpenAIを呼ぶコードは存在しない」としていましたが、
# 2026-07-27のPhase7で lib/ai/providers/openai/ が実装済みです(TASK_ROUTINGの値を
# 'openai' に切り替えると使われます)。ただし現時点でTASK_ROUTINGの既定値は全タスク
# anthropicのままのため、未設定でも他の機能には影響しません。
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Gemini (Google Generative Language API) [2026-08-05追加・ドキュメント化] ----
# 2026-07-27のPhase7で lib/ai/providers/gemini/ が実装済みですが、これまでこのファイルへの
# 記載が漏れていました(コード(lib/config/env.ts)は既にGEMINI_API_KEYを読む実装に
# なっています)。捺印表OCR Anthropic／Gemini比較検証CLI(npm run ocr:compare、
# 下記参照)を実データで実行する場合に必要です。本番のTASK_ROUTING既定値は
# 'anthropic' のまま変更していないため、これを設定しただけで本番の挙動が変わることは
# ありません。
# 取得先: https://aistudio.google.com/ → Get API key
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- タスク別OCRプロバイダ切替 [2026-08-05新設] ----
# 捺印表OCR Anthropic／Gemini比較検証プロジェクトの一環。lib/ai/config/taskRouting.ts の
# 既定値(現状すべて'anthropic')を、タスクごとに一時的に上書きしたい場合にのみ設定して
# ください。未設定であれば、これまでどおりAnthropicが使われ続けます(本番の既定値を
# 変更するものではありません)。値は 'anthropic' | 'openai' | 'gemini' のいずれか。
# OCR_PROVIDER_INSPECTION_SCHEDULE=anthropic       # 捺印表/点検希望時間連絡票
# OCR_PROVIDER_INSPECTION_SCHEDULE_SHEET=anthropic # 紙の点検予定表

# ---- 捺印表OCR比較検証CLI (npm run ocr:compare) について [2026-08-05追加] ----
# lib/ocr-compare/ 配下は、本番のOCR経路とは完全に分離した開発・検証専用のCLIツールです
# (本番のRoute Handler・app/api/**には一切追加していません)。実行するには上記の
# ANTHROPIC_API_KEY・GEMINI_API_KEY に加えて、SUPABASE_SERVICE_ROLE_KEY も設定されている
# 必要があります(既存のgetServerEnv()がSupabaseの鍵を必須項目として要求する実装のため。
# このCLI自体はSupabaseへは一切通信しません。ローカル実行時に本番のSupabaseキーが無ければ、
# ダミーの文字列で構いません)。
# 使い方: npm run ocr:compare -- single ./sample.jpg ./sample.ground-truth.json

# ---- Google Cloud (Vision API / Document AI) [2026-07-29追加] ----
# 捺印表(点検希望時間連絡票)OCRの精度検証用。Vercel等のサーバーレス環境では鍵ファイルを
# 安定して置けないため、サービスアカウントJSON鍵の「中身」を1行の文字列としてそのまま
# 環境変数へ入れる方式にしています(GOOGLE_APPLICATION_CREDENTIALSというファイルパスを
# 指す従来の方式ではありません)。取得手順は claude/GoogleCloud_Vision_DocumentAI_セットアップ手順_2026-07-29.md
# を参照してください。
# 【最重要】JSON鍵の中身を絶対にチャットやSlack、公開リポジトリに貼り付けないでください。
# GOOGLE_CLOUD_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}
# DOCUMENT_AI_LOCATION=us
# DOCUMENT_AI_OCR_PROCESSOR_ID=
# DOCUMENT_AI_FORM_PARSER_PROCESSOR_ID=

# ---- CORS(オリジン制限) ----
# このAPIをブラウザから呼び出してよいオリジンをカンマ区切りで指定します。
# 例: Live Boardの本番URL、Report Flowの本番URL、プレビュー環境のURL等。
# 【重要】未設定のまま本番運用しないでください(未設定時は開発用に全オリジンを
# 許可してしまいます)。実際のVercelデプロイURLが確定したら必ず設定してください。
ALLOWED_ORIGINS=https://your-live-board.vercel.app,https://your-report-flow.vercel.app

# ---- レート制限(利用回数制限) ----
# 未設定時は以下と同じ既定値が使われます。会社ごとの利用状況を見ながら調整してください。
# RATE_LIMIT_WINDOW_SECONDS=60      # このN秒間の
# RATE_LIMIT_MAX_PER_WINDOW=5       # 最大M回まで(バースト制限)
# RATE_LIMIT_MAX_PER_USER_PER_DAY=200   # 1ユーザーが1日に呼べる最大回数
# RATE_LIMIT_MAX_GLOBAL_PER_DAY=5000    # 全ユーザー合計で1日に呼べる最大回数(コスト上限)
